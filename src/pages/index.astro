---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Yinsheng (Ken) Dong | Software Engineer</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <main class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
      <header class="space-y-4">
        <p class="text-sm uppercase tracking-[0.2em] text-sky-300">Software Engineer</p>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Yinsheng (Ken) Dong</h1>
        <p class="max-w-2xl text-lg text-slate-300">
          I build high-quality mobile products with a focus on iOS engineering, performance, and user
          experience.
        </p>
      </header>

      <section class="mt-12 rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
        <h2 class="text-2xl font-semibold">About</h2>
        <p class="mt-3 leading-7 text-slate-300">
          I am a software engineer with strong analytical and problem-solving skills. I have experience
          building and maintaining large-scale iOS applications, including cybersecurity-focused
          capabilities such as VPN, web filtering, and mobile device management.
        </p>
      </section>

      <section class="mt-8">
        <h2 class="text-2xl font-semibold">Core Skills</h2>
        <ul class="mt-4 flex flex-wrap gap-2 text-sm">
          <li class="rounded-full border border-slate-700 bg-slate-900/60 px-3 py-1">Swift</li>
          <li class="rounded-full border border-slate-700 bg-slate-900/60 px-3 py-1">Objective-C</li>
          <li class="rounded-full border border-slate-700 bg-slate-900/60 px-3 py-1">C++</li>
          <li class="rounded-full border border-slate-700 bg-slate-900/60 px-3 py-1">iOS</li>
          <li class="rounded-full border border-slate-700 bg-slate-900/60 px-3 py-1">Android</li>
          <li class="rounded-full border border-slate-700 bg-slate-900/60 px-3 py-1">VPN and MDM</li>
        </ul>
      </section>

      <section class="mt-8">
        <h2 class="text-2xl font-semibold">Experience Highlights</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-5">
            <h3 class="font-semibold">Microsoft Teams iOS</h3>
            <p class="mt-2 text-sm text-slate-300">
              Working on the Calling, Meetings, and Devices (CMD) team to improve the Teams iOS
              experience.
            </p>
          </article>
          <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-5">
            <h3 class="font-semibold">FortiClient iOS</h3>
            <p class="mt-2 text-sm text-slate-300">
              Led and developed features for FortiClient, including IPSec VPN, SSL VPN, SASE, MDM, and
              web filtering.
            </p>
          </article>
          <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-5 sm:col-span-2">
            <h3 class="font-semibold">SalonScale Mobile</h3>
            <p class="mt-2 text-sm text-slate-300">
              Designed and developed cross-platform mobile features (iOS and Android) and improved
              quality through QA and customer feedback loops.
            </p>
          </article>
        </div>
      </section>

      <footer class="mt-12 border-t border-slate-800 pt-6 text-sm text-slate-400 space-y-2">
        <p>
          Contact:
          <a class="text-sky-300 hover:text-sky-200" href="mailto:kendong505@gmail.com">kendong505@gmail.com</a>
        </p>
        <p>
          <a class="text-sky-300 hover:text-sky-200" href="https://www.linkedin.com/in/yinshengdong/">LinkedIn</a>
          ·
          <a class="text-sky-300 hover:text-sky-200" href="https://github.com/yid164">GitHub</a>
        </p>
      </footer>
    </main>
  </body>
</html>
